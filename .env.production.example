# 生产环境变量模板。复制为 .env.deploy（不要用 .env.production.local：Next 会自动加载它），
# 或填入部署平台的环境变量配置。
# 每一项都必须在生产环境使用全新随机值，禁止复用本地开发值。

# ── 数据库 ──────────────────────────────────────────────────────────────
# Sealos 建库后从「数据库详情 → 连接信息」复制；内网地址优先（应用与库同区域时）。
# 公网访问需先在控制台开启公网暴露。
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public"

# ── 后台管理 ────────────────────────────────────────────────────────────
# 管理后台登录密码：至少 16 位随机字符串，上线后只保存在密码管理器。
ADMIN_PASSWORD="replace-with-16+char-random-string"
# 会话签名密钥：至少 32 位随机字符串（openssl rand -hex 32）。
ADMIN_SESSION_SECRET="replace-with-64-hex-random-string"

# ── 匿名反馈加盐 ────────────────────────────────────────────────────────
# 面试反馈匿名标识的加盐哈希。更换会导致历史反馈去重键变化，上线后不要再改。
ANON_SALT="replace-with-64-hex-random-string"

# ── 模型润色（DeepSeek）──────────────────────────────────────────────────
# 不配置 MODEL_API_KEY 时报告自动回落模板，功能可用但缺少模型措辞。
MODEL_API_KEY="sk-your-production-key"
MODEL_BASE_URL="https://api.deepseek.com/v1"
MODEL_NAME="deepseek-flash"
# 模型超时（毫秒）；生产建议 8000，失败自动回落模板。
MODEL_TIMEOUT_MS="8000"

# ── 站点地址（可选）────────────────────────────────────────────────────
# 用于 canonical、sitemap、Open Graph；不填时生产默认使用当前 Trae 域名。
NEXT_PUBLIC_SITE_URL="https://37l9q33xkr4i7ondk17.traesite.cn"

# ── 告警（可选）────────────────────────────────────────────────────────
# 来源健康检查的 Webhook 告警地址（企业微信/飞书机器人）。留空则不告警。
SOURCE_ALERT_WEBHOOK=""
