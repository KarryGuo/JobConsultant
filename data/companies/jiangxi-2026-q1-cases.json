      "signals": [
        {
          "type": "labor_violation",
          "period": "2026",
          "severity": "high",
          "value": {
            "count": 1,
            "subtype": "wage_arrears",
            "violation": "吉安市吉州区“星辰湾2#、6#、9#、19#楼”工程施工期间，施工总承包单位江西华索建筑工程有限公司承建该项目，劳务承包人彭跃善承包该项目土建工程相关劳务、机械及辅材。2025年6月，吉州区人社局接到该项目木工班组农民工投诉，反映该项目存在拖欠工资问题。经查，该项目拖欠木工班组12名劳动者工资150699元。彭跃善在项目施工期间通过虚构亲属名单、虚造工资表等方式套取并挪用专项农民工工资13万元；在具备支付能力的情况下消极应对，拒不办理房源过户及变现手续，存在逃避支付劳动报酬行为。",
            "workerCount": 12,
            "amountYuan": 150699,
            "authority": "吉州区人社局",
            "legalRep": "刘志勤",
            "stage": "重大劳动保障违法行为社会公布",
            "stageLabel": "社会公布"
          },
          "sourceUrl": "https://rst.jiangxi.gov.cn/jxsrlzyhshbzt/col/col47990/content/content_2072866923363344384.html",
